VITE_API_URL=http://localhost:4000/api

# Client ID de OAuth de Google para el botón "Continuar con Google" del login.
# Debe ser el MISMO valor que GOOGLE_CLIENT_ID en backend/.env. No es secreto
# (queda visible en el bundle del navegador), pero igual va por variable de
# entorno para poder cambiarlo entre entornos. Ver GUIA-COLABORADOR.md.
VITE_GOOGLE_CLIENT_ID=
