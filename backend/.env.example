PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=gsi_db

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Clave de la API de Anthropic (Claude), usada por el chat de recomendaciones
# con IA (POST /api/chat/recommend). Consíguela en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Clave de Google Places API para las llamadas SERVIDOR->Google (Text Search
# y Place Details) del script de recolección de datos (npm run collect-data).
# Créala en https://console.cloud.google.com/ -> APIs y servicios -> Habilitar
# "Places API" -> Credenciales -> Crear clave de API. NO le pongas restricción
# de HTTP referrer (el script corre en Node, sin navegador, y esa
# restricción la rechazaría) — restríngela por IP o déjala sin restringir.
GOOGLE_PLACES_API_KEY=

# Clave SEPARADA para las URLs de fotos de Google Places que ve el navegador
# (image_url). Esta sí debe restringirse por HTTP referrer a tu(s) dominio(s)
# (ver backend/README.md, sección "Restringir la API key de fotos"), porque
# queda visible en el HTML/red del frontend. Si la dejas vacía, el script cae
# de vuelta a GOOGLE_PLACES_API_KEY (funciona, pero esa expone la key server
# sin restricción de referrer al navegador).
GOOGLE_PLACES_PHOTO_KEY=
