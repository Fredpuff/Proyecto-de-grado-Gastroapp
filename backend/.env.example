PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=gsi_db

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Clave de la API de Anthropic (Claude), usada por el chat de recomendaciones
# con IA (POST /api/chat/recommend). Consíguela en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modelo usado por el análisis de sentimiento de reseñas (ABSA), ver
# backend/src/services/reviewNlp.service.js. Opcional: si se deja vacío, usa
# claude-haiku-4-5-20251001 por defecto.
REVIEW_NLP_MODEL=

# Clave de Google Places API para las llamadas SERVIDOR->Google (Text Search
# y Place Details) del script de recolección de datos (npm run collect-data).
# Créala en https://console.cloud.google.com/ -> APIs y servicios -> Habilitar
# "Places API" -> Credenciales -> Crear clave de API. NO le pongas restricción
# de HTTP referrer (el script corre en Node, sin navegador, y esa
# restricción la rechazaría) — restríngela por IP o déjala sin restringir.
GOOGLE_PLACES_API_KEY=

# Las fotos de los restaurantes también usan GOOGLE_PLACES_API_KEY, pero desde
# el backend (proxy con caché en disco, ver backend/README.md sección 1b): la
# key nunca llega al navegador, así que no hace falta una clave de fotos aparte.

# Client ID de OAuth de Google, usado para verificar el login con Google
# (POST /api/auth/google). Créalo en https://console.cloud.google.com/apis/credentials
# -> Crear credenciales -> ID de cliente de OAuth -> tipo "Aplicación web".
# Agrega http://localhost:5173 (y tu dominio de producción) en "Orígenes de
# JavaScript autorizados". Este mismo valor va también en frontend/.env como
# VITE_GOOGLE_CLIENT_ID (ver GUIA-COLABORADOR.md).
GOOGLE_CLIENT_ID=

# Client secret del mismo cliente OAuth de Google. El flujo de login que usa
# este proyecto (botón/One Tap de Google, credential = ID token) NO lo
# necesita para verificar el token — google-auth-library solo valida la
# firma contra los servidores de Google usando GOOGLE_CLIENT_ID. Se deja
# reservado aquí por si en el futuro se agrega un flujo de "authorization
# code" (ej. para pedir permisos adicionales a la API de Google). NUNCA lo
# pongas en el frontend.
GOOGLE_CLIENT_SECRET=
